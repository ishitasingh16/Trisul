<?xml version="1.0"?>
<package format="3">
  <name>navis_description</name>
  <version>0.1.0</version>
  <description>URDF, Webots worlds, and robot sensor descriptions for NAVIS.</description>
  <maintainer email="maintainer@navis.local">NAVIS Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>webots_ros2_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
