# NAVIS dynamic world extends the static warehouse with a Supervisor obstacle.
EXTERNPROTO "../../navis_description/protos/NavisRobot.proto"

WorldInfo { basicTimeStep 32 coordinateSystem "ENU" }
Viewpoint { position 8.5 9.5 10.5 orientation -0.62 0.42 0.66 2.15 }
Background { skyColor [ 0.18 0.22 0.28 ] luminous TRUE }
DirectionalLight { direction -0.4 -0.6 -1 intensity 1.2 }
Floor { size 16 12 tileSize 1 1 appearance PBRAppearance { baseColor 0.62 0.64 0.60 roughness 0.92 } }
Solid { translation 0 6 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.28 0.30 } geometry Box { size 16 0.20 1.5 } } ] boundingObject Box { size 16 0.20 1.5 } }
Solid { translation 0 -6 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.28 0.30 } geometry Box { size 16 0.20 1.5 } } ] boundingObject Box { size 16 0.20 1.5 } }
Solid { translation 8 0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.28 0.30 } geometry Box { size 0.20 12 1.5 } } ] boundingObject Box { size 0.20 12 1.5 } }
Solid { translation -8 0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.28 0.30 } geometry Box { size 0.20 12 1.5 } } ] boundingObject Box { size 0.20 12 1.5 } }
Solid { translation 2.5 2.5 0.55 children [ Shape { appearance PBRAppearance { baseColor 0.75 0.28 0.12 } geometry Box { size 1.2 1.2 1.1 } } ] boundingObject Box { size 1.2 1.2 1.1 } }
Solid { translation -2.0 2.8 0.40 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.42 0.68 } geometry Cylinder { radius 0.55 height 0.8 } } ] boundingObject Cylinder { radius 0.55 height 0.8 } }
DEF MOVING_OBSTACLE Solid { translation 0 0 0.55 children [ Shape { appearance PBRAppearance { baseColor 0.85 0.12 0.12 } geometry Box { size 1.0 1.0 1.1 } } ] boundingObject Box { size 1.0 1.0 1.1 } }
Transform { translation -6.2 -4.5 0.01 children [ Shape { appearance PBRAppearance { baseColor 0.10 0.65 0.28 } geometry Box { size 2.0 1.2 0.02 } } ] }
Transform { translation 6.2 4.5 0.01 children [ Shape { appearance PBRAppearance { baseColor 0.85 0.18 0.12 } geometry Box { size 2.0 1.2 0.02 } } ] }
DEF NAVIS_ROBOT NavisRobot { translation -6.2 -4.5 0.12 name "navis_robot" }
DEF MOVING_SUPERVISOR Supervisor { controller "moving_obstacle" }
