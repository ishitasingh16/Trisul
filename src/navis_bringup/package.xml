<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navis_bringup</name>
  <version>0.1.0</version>
  <description>System bringup, launch orchestrators, and metrics collector for NAVIS</description>
  <maintainer email="navis@trishul.local">NAVIS Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>navis_msgs</exec_depend>
  <exec_depend>navis_interfaces</exec_depend>
  <exec_depend>navis_perception</exec_depend>
  <exec_depend>navis_world_model</exec_depend>
  <exec_depend>navis_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
